{
  "name": "intellisoc-backend",
  "version": "1.0.0",
  "description": "IntelliSOC - Log-Based Cyber Attack Detection System Backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "node --env-file=.env -r ts-node/register src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "db:seed": "node dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.9.0",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
