# Database — SQLite (default for local dev)
# File path is relative to the prisma/ directory
DATABASE_URL="file:./dev.db"

# Server
PORT=5000

# Allowed CORS origins (comma-separated). Defaults to localhost:5173 when not set.
# In production set this to your real frontend URL, e.g. https://intellisoc.example.com
ALLOWED_ORIGINS="http://localhost:5173"

# AbuseIPDB API key — get one free at https://www.abuseipdb.com/register
# Leave blank to skip IP reputation lookups (alerts still work without it)
ABUSEIPDB_API_KEY="your_abuseipdb_api_key_here"

# AI API key — required for AI narrative generation (e.g. Gemini or Custom model)
AI_API_KEY="your_ai_api_key_here"

# Slack Webhook URL — for automated alerts (optional)
SLACK_WEBHOOK_URL="your_slack_webhook_url_here"

